rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny all direct client access.
    // All uploads, deletes, and downloads must go through the backend API,
    // which enforces role, tenant (schoolId), and quota checks and issues signed URLs.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
